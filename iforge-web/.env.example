# Copy this file to `.env.local` and fill in the values you need.
# `.env.local` is gitignored — your real secrets never get committed.

# ─────────────────────────────────────────────────────────────
# Admin panel (/admin)
# ─────────────────────────────────────────────────────────────
# The single password that gates the admin panel. Required to sign in.
ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────
# Supabase — storage for admin edits, enquiries and team photos.
# Without these, everything is saved to local files in `.data/` and
# `public/uploads/` (fine for development; most hosts don't keep files,
# so set these before going live).
# Create a free project at https://supabase.com, then from
# Project Settings → API copy:
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The service-role key (Project Settings → API → service_role). SERVER-ONLY —
# it bypasses row-level security, so never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# Email — confirmation to whoever sends an enquiry, and the "Send reply"
# button in the admin inbox. Uses Resend (free: 3,000 emails/month).
# Without these, no emails are sent and the Send button stays disabled.
# ─────────────────────────────────────────────────────────────
# API key from https://resend.com/api-keys (sending access is enough).
RESEND_API_KEY=
# Sender, on a domain you've verified in Resend → Domains, e.g.
# iForge Technologies <hello@iforge.in>. Customer replies go to the
# contact email in siteData.ts.
EMAIL_FROM=

# ─────────────────────────────────────────────────────────────
# GitHub contribution skyline (Community page)
# ─────────────────────────────────────────────────────────────
# The GitHub login whose contributions to display. Can also be set per-page
# from the admin panel (Community tab).
GITHUB_USERNAME=k4ran909
# A Personal Access Token — the contributions GraphQL query requires auth.
# A classic token with `read:user` scope is enough; no repo scope needed.
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=

# ─────────────────────────────────────────────────────────────
# Hermes agent — triages website enquiries (see ADMIN.md, hermes/)
# ─────────────────────────────────────────────────────────────
# Push: new enquiries are POSTed to this Hermes webhook route.
HERMES_WEBHOOK_URL=
# Shared secret for Hermes's V2 webhook signature
# (X-Webhook-Signature-V2 over "<timestamp>.<body>"). Must equal
# WEBHOOK_SECRET in ~/.hermes/.env on the VPS. Any long random string.
HERMES_WEBHOOK_SECRET=
# Pull: the key Hermes sends as `Authorization: Bearer <key>` to the MCP
# endpoint (/api/mcp) and /api/agent/*. Must equal IFORGE_AGENT_KEY in
# ~/.hermes/.env. Any long random string.
AGENT_API_KEY=
