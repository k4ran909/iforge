# Values for ~/.hermes/.env on the VPS running Hermes Agent.
# A filled-in copy with generated keys may already exist at hermes/hermes.env
# (gitignored) — use that one if so; this file just documents each value.

# Webhook receiver — the website posts new enquiries here.
WEBHOOK_ENABLED=true
WEBHOOK_PORT=8644
# Must equal HERMES_WEBHOOK_SECRET on the website.
WEBHOOK_SECRET=

# How Hermes reaches the website's MCP tools.
# The site's public address (no trailing slash), e.g. https://iforge.in
IFORGE_SITE_URL=
# Must equal AGENT_API_KEY on the website.
IFORGE_AGENT_KEY=
